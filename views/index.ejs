<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <%- include("header") %>
    <h1>
        <%= title %>
    </h1>
    <% for (let i = 0; i < messages.length; i++){ %>
        <div>
            <h3><%= messages[i].user %></h3>
            <p><%= messages[i].text %></p>
            <time datetime="<%= messages[i].added.toISOString() %>"><i><%= messages[i].added.toLocalString() %></i></time>
            <a href="/message/<%= messages[i].id %>">View details</a>
        </div>
    <% } %>
</body>
</html>
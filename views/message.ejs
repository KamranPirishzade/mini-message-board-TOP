<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= username %>'s message details</title>
  </head>
  <body>
    <%- include("header") %>

    <h2><%= username %></h2>
    <p><%= message %></p>
    <time datetime="<%= added.toISOString() %>"
      ><i><%= added.toLocaleString() %></i></time
    >
  </body>
</html>
